# Track only what we write ourselves: torrc, .bat scripts, docs (.md)
# Ignore anything re-downloadable, generated by tor at runtime, or secret

# ── Tor Browser (whole folder — always re-downloadable from torproject.org) ──
Tor Browser/
tor-browser*/

# ── Tor Expert Bundle: binaries and bundled files ──
*.exe
*.dll
TorExpertBundle/tor/pluggable_transports/
TorExpertBundle/docs/
TorExpertBundle/**/geoip
TorExpertBundle/**/geoip6

# ── Created by tor at runtime (DataDirectory: cache, state, lock) ──
TorExpertBundle/data/
TorExpertBundle/Data/
*.log
log.txt

# ── Onion Service secret keys — never commit ──
# (hostname is shareable, but it lives next to the keys, so the whole folder is excluded)
TorHiddenService*/
**/hs_ed25519_secret_key
**/hs_ed25519_public_key
**/authorized_clients/
*.auth
*.auth_private

# ── Downloads / signature verification ──
*.asc
*.tar.xz
*.tar.gz
*.zip
*.keyring

# ── OS / editor ──
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp
